datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

model Account {
  id        String    @id
  token     String    @map("token")
  name      String    @map("name")
  status    Int       @default(1) @map("status")
  // Legacy owner column kept for migration compatibility. Use AccountUser for access.
  userId    String?   @map("user_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at")

  users AccountUser[]

  @@index([userId])
  @@map("accounts")
}

model User {
  id           String    @id
  username     String    @unique @map("username")
  role         String    @default("user") @map("role")
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime? @default(now()) @updatedAt @map("updated_at")

  accounts AccountUser[]
  feeds    UserFeed[]
  sessions Session[]
  conversations KnowledgeConversation[]

  @@map("users")
}

model Session {
  id        String   @id
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model KnowledgeConversation {
  id               String    @id
  userId           String    @map("user_id")
  title            String    @map("title")
  categories       String    @default("[]") @map("categories")
  useKnowledgeBase Boolean   @default(true) @map("use_knowledge_base")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime? @default(now()) @updatedAt @map("updated_at")

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages KnowledgeMessage[]

  @@index([userId])
  @@index([updatedAt])
  @@map("knowledge_conversations")
}

model KnowledgeMessage {
  id             String   @id
  conversationId String   @map("conversation_id")
  role           String   @map("role")
  content        String   @map("content")
  sources        String   @default("[]") @map("sources")
  sequence       Int      @map("sequence")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation KnowledgeConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([sequence])
  @@map("knowledge_messages")
}

model AccountUser {
  userId    String    @map("user_id")
  accountId String    @map("account_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([userId, accountId])
  @@index([accountId])
  @@map("account_users")
}

model UserFeed {
  userId    String    @map("user_id")
  feedId    String    @map("feed_id")
  status    Int       @default(1) @map("status")
  category  String    @default("") @map("category")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  feed Feed @relation(fields: [feedId], references: [id], onDelete: Cascade)

  @@id([userId, feedId])
  @@index([feedId])
  @@map("user_feeds")
}

model Feed {
  id         String    @id
  mpName     String    @map("mp_name")
  mpCover    String    @map("mp_cover")
  mpIntro    String    @map("mp_intro")
  status     Int       @default(1) @map("status")
  syncTime   Int       @default(0) @map("sync_time")
  updateTime Int       @map("update_time")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime? @default(now()) @updatedAt @map("updated_at")
  hasHistory Int?      @default(1) @map("has_history")
  category   String    @default("") @map("category")

  users UserFeed[]

  @@map("feeds")
}

model Article {
  id          String    @id
  mpId        String    @map("mp_id")
  title       String    @map("title")
  picUrl      String    @map("pic_url")
  publishTime Int       @map("publish_time")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at")

  @@map("articles")
}
