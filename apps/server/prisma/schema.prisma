datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

model Account {
  id        String    @id @db.VarChar(255)
  token     String    @map("token") @db.VarChar(2048)
  name      String    @map("name") @db.VarChar(1024)
  status    Int       @default(1) @map("status") @db.Int()
  // Legacy owner column kept for migration compatibility. Use AccountUser for access.
  userId    String?   @map("user_id") @db.VarChar(36)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at")

  users AccountUser[]

  @@index([userId])
  @@map("accounts")
}

model User {
  id           String    @id @db.VarChar(36)
  username     String    @unique @map("username") @db.VarChar(255)
  role         String    @default("user") @map("role") @db.VarChar(32)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime? @default(now()) @updatedAt @map("updated_at")

  accounts AccountUser[]
  feeds    UserFeed[]
  sessions Session[]

  @@map("users")
}

model Session {
  id        String   @id @db.VarChar(36)
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  userId    String   @map("user_id") @db.VarChar(36)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AccountUser {
  userId    String    @map("user_id") @db.VarChar(36)
  accountId String    @map("account_id") @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([userId, accountId])
  @@index([accountId])
  @@map("account_users")
}

model UserFeed {
  userId    String    @map("user_id") @db.VarChar(36)
  feedId    String    @map("feed_id") @db.VarChar(255)
  status    Int       @default(1) @map("status") @db.Int()
  category  String    @default("") @map("category") @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  feed Feed @relation(fields: [feedId], references: [id], onDelete: Cascade)

  @@id([userId, feedId])
  @@index([feedId])
  @@map("user_feeds")
}

model Feed {
  id         String    @id @db.VarChar(255)
  mpName     String    @map("mp_name") @db.VarChar(512)
  mpCover    String    @map("mp_cover") @db.VarChar(1024)
  mpIntro    String    @map("mp_intro") @db.Text()
  status     Int       @default(1) @map("status") @db.Int()
  syncTime   Int       @default(0) @map("sync_time")
  updateTime Int       @map("update_time")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime? @default(now()) @updatedAt @map("updated_at")
  hasHistory Int?      @default(1) @map("has_history")
  category   String    @default("") @map("category") @db.VarChar(255)

  users UserFeed[]

  @@map("feeds")
}

model Article {
  id          String    @id @db.VarChar(255)
  mpId        String    @map("mp_id") @db.VarChar(255)
  title       String    @map("title") @db.VarChar(255)
  picUrl      String    @map("pic_url") @db.VarChar(255)
  publishTime Int       @map("publish_time")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at")

  @@map("articles")
}
